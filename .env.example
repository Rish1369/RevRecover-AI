# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rra:rra_secret@localhost:5432/revenue_recovery
SYNC_DATABASE_URL=postgresql://rra:rra_secret@localhost:5432/revenue_recovery

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── App Security ────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production

# ─── Anthropic ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Razorpay (seeded test merchant — test mode only) ────────────────────────
# These go into the merchants table at seed time; per-merchant keys are stored
# encrypted in the DB in production. For Phase 1 we use env vars for the seed.
SEED_RAZORPAY_KEY_ID=rzp_test_...
SEED_RAZORPAY_KEY_SECRET=...
SEED_RAZORPAY_WEBHOOK_SECRET=...

# ─── Attribution window (days) ───────────────────────────────────────────────
ATTRIBUTION_WINDOW_DAYS=7

# ─── CORS (comma-separated) ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Celery beat schedule (seconds between attribution scans) ────────────────
ATTRIBUTION_SCAN_INTERVAL=300
